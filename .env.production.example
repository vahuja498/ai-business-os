# ==============================================================================
# AI BUSINESS OS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core System
ENVIRONMENT=production
DEBUG=false

# Database Configuration (PostgreSQL with asyncpg driver)
# E.g. Supabase, Neon (AWS Mumbai ap-south-1), or local Docker Postgres
DATABASE_URL=postgresql+asyncpg://os_admin:secure_prod_password@postgres:5432/ai_business_os_prod

# Allowed CORS origins for API (comma-separated or JSON list)
CORS_ORIGINS=["https://your-domain.com", "https://ai-business-os.vercel.app"]

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY RAILS (INDIA - RAZORPAY)
# ------------------------------------------------------------------------------
# Options: "mock" (for zero-risk test mode) or "razorpay" (for real UPI / cards)
PAYMENT_PROVIDER=mock

# Options: "sandbox" (test keys) or "live" (production payments)
PAYMENT_MODE=sandbox

# Razorpay API Credentials (Obtain from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# ------------------------------------------------------------------------------
# FINANCIAL SAFETY & GUARDRAIL CAPS (INR)
# ------------------------------------------------------------------------------
# Max daily marketing budget that autonomous agents can disburse without human signoff
MAX_DAILY_SPEND=500.0

# Max single transaction amount allowed without dual human approval
MAX_TRANSACTION_AMOUNT=10000.0

# Max monthly cumulative spend cap
MAX_MONTHLY_SPEND=10000.0

# Minimum acceptable contribution margin
MIN_MARGIN=0.20

# ------------------------------------------------------------------------------
# AI & SEARCH PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search provider (for automated opportunity evidence gathering)
WEB_SEARCH_PROVIDER=mock
SERPAPI_API_KEY=
TAVILY_API_KEY=
