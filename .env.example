# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# PostgreSQL target: postgresql+asyncpg://user:password@localhost:5432/ai_business_os
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./ai_business_os.db

# Financial Guardrails
MAX_DAILY_SPEND=500.0
MAX_TRANSACTION_AMOUNT=1000.0
MAX_MONTHLY_SPEND=10000.0
MIN_MARGIN=0.20
MIN_CASH_RESERVE=5000.0

# Autonomy
DEFAULT_AUTONOMY_LEVEL=LEVEL_1_ASSIST

# Vendor-Neutral AI Model Providers
# Set MODEL_PROVIDER to 'mock', 'openai', 'gemini', or 'anthropic'
MODEL_PROVIDER=mock
MODEL_NAME=default-model
RESEARCH_MODEL=
CEO_MODEL=
CLASSIFICATION_MODEL=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
