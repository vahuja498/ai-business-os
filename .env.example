# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# Use PostgreSQL in production or staging: postgresql+asyncpg://user:password@localhost:5432/ai_business_os
# In local development without Postgres, leave empty or use sqlite+aiosqlite:///./ai_business_os.db
DATABASE_URL=sqlite+aiosqlite:///./ai_business_os.db

# Financial Guardrails
MAX_DAILY_SPEND=500.0
MAX_TRANSACTION_AMOUNT=1000.0
MAX_MONTHLY_SPEND=10000.0
MIN_MARGIN=0.20
MIN_CASH_RESERVE=5000.0

# Autonomy
DEFAULT_AUTONOMY_LEVEL=LEVEL_1_ASSIST

# Optional Model Providers (not required for local tests/mock runs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
